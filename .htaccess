# Cavaleri Srl — Apache-Konfiguration (All-Inkl, IONOS, Aruba und ähnliche).
# Liegt im Wurzelverzeichnis der Domain.

# ---------- Fehlerseite ----------------------------------------------------
ErrorDocument 404 /404.html

# ---------- Eine einzige gültige Adresse -----------------------------------
# https erzwingen und auf www vereinheitlichen; Verzeichnisse mit Schrägstrich.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://www.cavaleri.it/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^(.*)$ https://www.cavaleri.it/$1 [R=301,L]

  # Alte Adressen der bisherigen Seite auf die neuen Verzeichnisse.
  RewriteRule ^azienda\.html?$        /azienda/     [R=301,L]
  RewriteRule ^trasporti\.html?$      /trasporti/   [R=301,L]
  RewriteRule ^edilizia\.html?$       /edilizia/    [R=301,L]
  RewriteRule ^ingrosso.*\.html?$     /edilizia/    [R=301,L]
  RewriteRule ^gallery\.html?$        /gallery/     [R=301,L]
  RewriteRule ^galleria\.html?$       /gallery/     [R=301,L]
  RewriteRule ^contatti\.html?$       /contatti/    [R=301,L]
  RewriteRule ^preventivi?\.html?$    /preventivo/  [R=301,L]
  RewriteRule ^index\.html?$          /             [R=301,L]

  # /azienda ohne Schrägstrich -> /azienda/
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# ---------- Kompression ----------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# ---------- Zwischenspeicher ----------------------------------------------
# Bilder, Schriften und Film tragen ihre Breite im Namen und ändern sich nicht:
# ein Jahr. HTML nie lange halten, sonst sieht niemand Änderungen.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif              "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType video/mp4               "access plus 1 year"
  ExpiresByType text/css                "access plus 7 days"
  ExpiresByType application/javascript  "access plus 7 days"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

# ---------- Sicherheit und Sparsamkeit -------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  # Die Seite lädt nichts von Dritten. Das lässt sich auch durchsetzen:
  Header set Content-Security-Policy "default-src 'self'; img-src 'self' data:; media-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self' mailto:"
</IfModule>

# ---------- MIME-Typen, falls der Server sie nicht kennt --------------------
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType font/woff2 .woff2
</IfModule>

# Verzeichnislisten aus
Options -Indexes
